{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "YOUR-CUSTOMER-WORKER-NAME",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html"
    ]
  }
}
