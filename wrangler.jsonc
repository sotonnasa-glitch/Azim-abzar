{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azim",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      "node_modules/**",
      ".git/**"
    ]
  }
}
