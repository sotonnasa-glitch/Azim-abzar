# ============================================================
# Azim Abzar — self-hosted backend / handover environment
# Copy to .env locally. Never commit the real file.
# ============================================================

# Optional local backend port
PORT=3000

# Exact public frontend origin(s), comma-separated when needed
AZIM_ALLOWED_ORIGIN=https://YOUR-DOMAIN.example

# Supabase project used by the backend / Edge Function-compatible services
AZIM_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
AZIM_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# AI provider secrets — server-side only
GEMINI_API_KEY=
OPENAI_API_KEY=

# Telegram admin bot — server-side only
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# Public site URL used by server-side integrations when links must be generated
AZIM_PUBLIC_SITE_URL=https://YOUR-DOMAIN.example
